---
import type { Locale } from "../../data/site";
import type { TreatmentItem as TreatmentEntry } from "../../lib/treatments";
import { formatPrice } from "../../lib/format";
import { useTranslations } from "../../i18n/utils";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import { buildBookingMessage } from "../../lib/booking";

interface Props {
  item: TreatmentEntry;
  lang: Locale;
}

const { item, lang } = Astro.props;
const t = useTranslations(lang);

const enquireUrl = buildWhatsAppUrl(
  buildBookingMessage({ topic: "treatment", treatment: item.name }, t),
);
---

<li
  data-treatment
  data-id={item.id}
  data-price={item.price}
  data-available={String(item.available)}
  class:list={["py-4", !item.available && "opacity-60"]}
>
  <div class="price-leader">
    <span class="font-medium">{item.name}</span>
    <span class="leader" aria-hidden="true"></span>
    <span data-price-display class="font-semibold tabular-nums">
      {formatPrice(item.price)}
    </span>
  </div>

  <p class="mt-1 text-xs font-medium uppercase tracking-wide text-accent">
    {item.duration}
    {t("common.minutes")}
  </p>

  {
    item.description && (
      <p class="mt-1 text-sm text-text-muted">{item.description}</p>
    )
  }

  <div class="mt-2 flex flex-wrap items-center gap-3">
    {
      item.available ? (
        <a
          href={enquireUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-primary underline"
        >
          {t("treatments.book")}
        </a>
      ) : (
        <span data-unavailable class="text-xs font-semibold text-danger">
          {t("treatments.unavailable")}
        </span>
      )
    }
    {
      item.note && (
        <span class="text-xs font-medium text-accent">{item.note}</span>
      )
    }
  </div>
</li>
