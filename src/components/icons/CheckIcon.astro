---
/**
 * Small check/leaf-style tick used for trust cues. Inherits `currentColor`.
 */
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "", size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M20 6L9 17l-5-5"></path>
</svg>
