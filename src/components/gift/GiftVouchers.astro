---
import type { Locale } from "../../data/site";
import { useTranslations } from "../../i18n/utils";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import { buildBookingMessage } from "../../lib/booking";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const href = buildWhatsAppUrl(buildBookingMessage({ topic: "voucher" }, t));
---

<section id="gift-vouchers" class="container-page py-12">
  <div
    class="relative overflow-hidden rounded-2xl border border-border bg-surface-alt p-6 sm:p-8"
  >
    <div
      class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-accent/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-2xl">
      <span class="eyebrow">{t("gift.title")}</span>
      <h2 class="mt-3 font-heading text-3xl">{t("gift.title")}</h2>
      <p class="mt-3 text-text-muted">{t("gift.body")}</p>
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mt-5"
      >
        <WhatsAppIcon size={18} />
        {t("gift.cta")}
      </a>
    </div>
  </div>
</section>
