---
import type { Locale } from "../../data/site";
import { packages } from "../../data/packages";
import { formatPrice } from "../../lib/format";
import { pickLocalized } from "../../lib/treatments";
import { useTranslations } from "../../i18n/utils";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import { buildBookingMessage } from "../../lib/booking";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="packages" class="section container-page">
  <header class="mb-6">
    <h2 class="font-heading text-3xl sm:text-4xl">{t("packages.title")}</h2>
    <p class="mt-2 max-w-2xl text-text-muted">{t("packages.subtitle")}</p>
  </header>

  <ul class="grid gap-5 md:grid-cols-2">
    {
      packages.map((pkg) => {
        const name = pickLocalized(pkg.name, lang);
        const enquireUrl = buildWhatsAppUrl(
          buildBookingMessage({ topic: "package", treatment: name }, t),
        );
        return (
          <li class="card flex h-full flex-col p-5 sm:p-6">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-heading text-2xl">{name}</h3>
              {pkg.featured && (
                <span class="badge shrink-0 bg-accent text-white">
                  {t("packages.popular")}
                </span>
              )}
            </div>
            <p class="mt-2 text-sm text-text-muted">
              {pickLocalized(pkg.description, lang)}
            </p>

            <p class="mt-4 text-xs font-medium uppercase tracking-wide text-accent">
              {pkg.duration} {t("common.minutes")}
            </p>

            <p class="mt-3 text-sm font-semibold">{t("packages.includes")}</p>
            <ul class="mt-1 space-y-1 text-sm text-text-muted">
              {pkg.includes.map((line) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-primary">
                    ·
                  </span>
                  <span>{pickLocalized(line, lang)}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto flex items-center justify-between gap-3 pt-6">
              <span class="font-heading text-2xl">
                {formatPrice(pkg.price)}
              </span>
              <a
                href={enquireUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline !min-h-10 !px-4 text-sm"
              >
                <WhatsAppIcon size={16} />
                {t("packages.book")}
              </a>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
