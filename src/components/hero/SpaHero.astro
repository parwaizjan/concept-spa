---
import { site, type Locale } from "../../data/site";
import { useTranslations } from "../../i18n/utils";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import { buildBookingMessage } from "../../lib/booking";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";
import CheckIcon from "../icons/CheckIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tagline = site.tagline[lang] ?? site.tagline.en;
const bookingUrl = buildWhatsAppUrl(buildBookingMessage({}, t));
const trust = ["hero.trust1", "hero.trust2"] as const;
---

<section class="relative overflow-hidden bg-surface-alt">
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="container-page grid items-center gap-8 py-10 lg:grid-cols-2 lg:gap-12 lg:py-14"
  >
    <div class="relative">
      <svg
        viewBox="0 0 120 120"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        class="pointer-events-none absolute -left-10 -top-10 hidden h-44 w-44 text-primary/[0.08] lg:block"
      >
        <path
          d="M60 8C30 30 14 60 14 92c0 12 6 20 12 20 34 0 66-18 80-44C98 50 80 24 60 8Z"
        ></path>
        <path d="M60 8C58 44 52 78 26 112"></path>
      </svg>

      <span class="eyebrow">{t("hero.eyebrow")}</span>
      <h1
        class="mt-3 font-heading text-5xl leading-[1.0] sm:text-6xl xl:text-7xl"
      >
        {site.name}
      </h1>
      <p class="mt-4 max-w-lg text-lg text-text-muted sm:text-xl">{tagline}</p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <WhatsAppIcon size={18} />
          {t("hero.cta")}
        </a>
        <a href="#treatments" class="btn btn-outline">{t("hero.treatments")}</a>
      </div>

      <ul
        class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-text-muted"
      >
        {
          trust.map((key) => (
            <li class="flex items-center gap-1.5">
              <CheckIcon class="text-primary" size={15} />
              {t(key)}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative">
      <picture>
        <source media="(max-width: 639px)" srcset={site.heroImageMobile} />
        <img
          src={site.heroImage}
          alt={t("hero.imageAlt")}
          width="1400"
          height="1050"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[4/5] w-full rounded-2xl border border-border object-cover lg:aspect-auto lg:h-[58vh]"
        />
      </picture>
      <div
        class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-t from-[#1e2a22]/30 via-transparent to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>
