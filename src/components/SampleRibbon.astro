---
import { site, type Locale } from "../data/site";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { useTranslations } from "../i18n/utils";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The ribbon link is a website enquiry (untagged — not a spa visitor message).
const enquiry = t("ribbon.enquiry").replace("{name}", site.name);
const href = buildWhatsAppUrl(enquiry);
---

{
  site.showDemoRibbon && (
    <div class="demo-ribbon">
      <div class="container-page">
        {t("ribbon.text")}
        {" · "}
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1"
        >
          <WhatsAppIcon size={13} />
          {t("common.messageUs")}
        </a>
      </div>
    </div>
  )
}
