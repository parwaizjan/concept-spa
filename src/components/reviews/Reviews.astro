---
import type { Locale } from "../../data/site";
import { testimonials } from "../../data/testimonials";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="reviews" class="bg-surface-alt py-12">
  <div class="container-page">
    <h2 class="mb-6 font-heading text-3xl">{t("testimonials.title")}</h2>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        testimonials.map((testimonial) => (
          <li class="card flex h-full flex-col p-4">
            <p class="text-text-muted">
              “{testimonial.quote[lang] ?? testimonial.quote.en}”
            </p>
            <p class="mt-3 text-sm font-semibold">{testimonial.author}</p>
            {testimonial.detail && (
              <p class="text-xs text-text-muted">
                {testimonial.detail[lang] ?? testimonial.detail.en}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
