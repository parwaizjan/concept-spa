---
import { site, type Locale } from "../data/site";
import { useTranslations, localizePath } from "../i18n/utils";
import { buildWhatsAppUrl } from "../lib/whatsapp";
import { buildBookingMessage } from "../lib/booking";
import LangSwitcher from "./LangSwitcher.astro";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const home = localizePath("/", lang);
const links = [
  { key: "nav.treatments", href: "#treatments" },
  { key: "nav.packages", href: "#packages" },
  { key: "nav.gallery", href: "#gallery" },
  { key: "nav.about", href: "#about" },
  { key: "nav.visit", href: "#visit" },
] as const;

// Anchor to the localized home page so links also work from /404.
const anchor = (hash: string) => `${home}${hash}`;

const linkClass =
  "inline-flex min-h-9 items-center whitespace-nowrap rounded-full px-3 text-sm font-medium text-text-muted hover:bg-surface-alt hover:text-text";

// Mobile keeps a compact, non-scrolling row: drop "About" (still in the footer)
// and tighten padding so every chip fits without clipping at 375px.
const mobileLinks = links.filter((link) => link.key !== "nav.about");
const mobileLinkClass =
  "inline-flex min-h-9 items-center whitespace-nowrap rounded-full px-2.5 text-sm font-medium text-text-muted hover:bg-surface-alt hover:text-text";

const bookingUrl = buildWhatsAppUrl(buildBookingMessage({}, t));
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-3 py-2.5">
    <a href={home} class="flex items-center gap-2" aria-label={site.name}>
      <img src={site.logo} alt="" width="36" height="36" />
      <span class="whitespace-nowrap font-heading text-lg sm:text-xl">
        {site.name}
      </span>
    </a>

    <nav
      class="hidden items-center gap-0.5 lg:flex"
      aria-label={t("nav.treatments")}
    >
      {
        links.map((link) => (
          <a href={anchor(link.href)} class={linkClass}>
            {t(link.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitcher lang={lang} />
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary !min-h-10 whitespace-nowrap !px-3 text-sm sm:!px-4"
      >
        <WhatsAppIcon size={16} />
        <span class="hidden sm:inline">{t("common.bookWhatsApp")}</span>
        <span class="sm:hidden">{t("common.bookShort")}</span>
      </a>
    </div>
  </div>

  <nav class="container-page lg:hidden" aria-label={t("nav.treatments")}>
    <ul class="no-scrollbar flex gap-1 overflow-x-auto py-1.5">
      {
        mobileLinks.map((link) => (
          <li>
            <a href={anchor(link.href)} class={mobileLinkClass}>
              {t(link.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
