---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/404" title={t("notFound.title")}>
  <section class="container-page py-20 text-center">
    <p class="font-heading text-5xl text-primary">404</p>
    <h1 class="mt-3 font-heading text-2xl">{t("notFound.title")}</h1>
    <p class="mt-2 text-text-muted">{t("notFound.body")}</p>
    <a href="/" class="btn btn-primary mt-6">{t("notFound.cta")}</a>
  </section>
</BaseLayout>
